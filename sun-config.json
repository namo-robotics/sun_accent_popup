{
  "root": true,
  "sun_path": [
    "build",
    "build/dependencies/sun_ui/build",
    "build/dependencies/sun_gobject/build"
  ],
  "entrypoints": [
    {
      "name": "sun_accent_popup",
      "path": "src/main.sun",
      "type": "binary",
      "output_name": "build/sun_accent_popup"
    },
    {
      "name": "tests",
      "path": "tests/main.sun",
      "type": "binary",
      "output_name": "build/accent-tests",
      "test_binary_name": "build/accent-tests_test"
    },
    {
      "name": "build-tool",
      "path": "src/tools/build.sun",
      "type": "binary",
      "output_name": "build/accent-build"
    },
    {
      "name": "ibus-bridge",
      "path": "native/ibus_bridge.c",
      "type": "library",
      "output_name": "build/native/libaccent_ibus.a"
    },
    {
      "name": "ibus-client",
      "path": "tests/ibus_client.c",
      "type": "binary",
      "output_name": "build/ibus-client"
    },
    {
      "name": "package-tool",
      "path": "src/tools/package.sun",
      "type": "binary",
      "output_name": "build/accent-package-tool"
    }
  ]
}
