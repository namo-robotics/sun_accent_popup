{
  "root": true,
  "entrypoints": [
    {
      "name": "sun_accent_popup",
      "path": "src/main.sun",
      "type": "binary",
      "export": true,
      "enabled": {
        "default": false,
        "target": {
          "x86_64-linux-gnu": true,
          "x86_64-linux-musl": true
        }
      },
      "steps": [
        "native"
      ],
      "compile_args": [
        "--dynamic",
        "-L${SUN_BUILD}/native",
        "-laccent_ibus",
        "-L${namo-robotics/sun_gobject}/lib/native",
        "-lsun_gobject_native",
        "-lm"
      ],
      "pkg_config": [
        "gtk4",
        "ibus-1.0"
      ]
    },
    {
      "name": "accent_tests",
      "path": "tests/main.sun",
      "type": "binary",
      "export": false,
      "enabled": {
        "default": false,
        "target": {
          "x86_64-linux-gnu": true,
          "x86_64-linux-musl": true
        }
      },
      "steps": [
        "native"
      ],
      "compile_args": [
        "--dynamic",
        "-L${SUN_BUILD}/native",
        "-laccent_ibus",
        "-L${namo-robotics/sun_gobject}/lib/native",
        "-lsun_gobject_native",
        "-lm"
      ],
      "pkg_config": [
        "gtk4",
        "ibus-1.0"
      ]
    },
    {
      "name": "accent_build",
      "path": "src/tools/build.sun",
      "type": "binary",
      "export": false,
      "enabled": {
        "default": false,
        "target": {
          "x86_64-linux-gnu": true,
          "x86_64-linux-musl": true
        }
      }
    },
    {
      "name": "accent_package_tool",
      "path": "src/tools/package.sun",
      "type": "binary",
      "export": false,
      "enabled": {
        "default": false,
        "target": {
          "x86_64-linux-gnu": true,
          "x86_64-linux-musl": true
        }
      }
    }
  ],
  "package_id": "namo-robotics/sun_accent_popup",
  "dependencies": [
    {
      "target": {
        "x86_64-linux-gnu": {
          "git": "git@github.com:namo-robotics/sun_ui.git",
          "version": "main",
          "packages": {
            "namo-robotics/sun_ui": {
              "entrypoints": [
                "sun_ui",
                "sun_ui_gtk"
              ]
            }
          }
        }
      }
    },
    {
      "target": {
        "x86_64-linux-gnu": {
          "git": "git@github.com:namo-robotics/sun_gobject.git",
          "version": "main",
          "packages": {
            "namo-robotics/sun_gobject": {
              "entrypoints": [
                "sun_gobject",
                "sun_gtk"
              ]
            }
          }
        }
      }
    }
  ],
  "steps": [
    {
      "name": "native",
      "enabled": {
        "default": false,
        "target": {
          "x86_64-linux-gnu": true,
          "x86_64-linux-musl": true
        }
      },
      "command": [
        "bash",
        "scripts/build-native.sh",
        "${SUN_BUILD}"
      ],
      "inputs": [
        "scripts/build-native.sh",
        "native",
        "tests/ibus_client.c"
      ],
      "outputs": [
        "${SUN_BUILD}/native/libaccent_ibus.a",
        "${SUN_BUILD}/ibus-client"
      ]
    }
  ]
}
