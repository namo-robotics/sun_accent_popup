using std;

/** Presents setup guidance and an ordinary client text field using sun_ui. */
module accent_app {

  /** Adds a readable paragraph to the current window. */
  function label(view: ref ui.View, key: i64, text: String) AllocationResult<void> {
    var element = try ui.Element(try ui.Key(key), ui.Kind.Label);
    element.text = text;
    element.margin = 8;
    try view.append(-1, element);

    return AllocationResult.Ok;
  }

  /** Builds the practice window without owning input-method or GTK handles. */
  function view(state: const ref accent.State) SystemResult<ui.View> {
    var a = make_heap_allocator();
    var result = try ui.View(a);
    try label(result, 1, try String("Sun Accent Popup"));
    try label(
      result,
      2,
      try String("Select Sun Accent Popup in GNOME’s input sources first.")
    );
    try label(
      result,
      3,
      try String("Hold a, c, e, i, n, o, s, u, y, or z to see accents.")
    );
    try label(
      result,
      4,
      try String(
        "Choose with a number, ← / → and Enter, or a click. Esc keeps the plain letter."
      )
    );
    var input = try ui.Element(try ui.Key(5), ui.Kind.TextInput);
    input.text = try state.text.clone(a);
    input.action = 1;
    input.margin = 16;
    input.min_width = 600;
    try result.append(-1, input);
    try label(
      result,
      6,
      try String("Try: café · mañana · über · français · São Paulo")
    );
    try label(
      result,
      7,
      try String("The selected input method also works in other IBus-enabled applications.")
    );
    try result.button(8, try String("Clear practice text"), 2, 0);
    return SystemResult.Ok(result);
  }

  /** Retains edits in application state and clears only the practice field on request. */
  function handle(
    state: ref accent.State,
    event: const ref ui.Event,
    queue: ref ui.EventQueue
  ) SystemResult<void> {
    if (event.action == 1 and event.value.kind == ui.ValueKind.Text) {
      state.text = try event.value.text.clone(make_heap_allocator());
    } else if (event.action == 2) {
      state.text = try String("");
    }
    return SystemResult.Ok;
  }

  /** Runs the independent practice window or checks its native text event pipeline. */
  public function run(automated: bool) std.Result<void> {
    var title = try String("Sun Accent Popup");
    var renderer = try ui_gtk.Renderer(
      title,
      try String("org.namo_robotics.AccentPopup")
    );
    try renderer.set_default_size(720, 340);
    var session = try ui.Session<accent.State>(try accent.State(), view, handle);
    try session.render(renderer);
    if (automated) {
      var text = try String("café · É · ñ");
      try renderer.edit(try session.tree.identity(5), text, 0);
      try renderer.poll(session.tree, session.queue, false);
      try session.dispatch(renderer);
      if (not session.state.text.equals(text)) {
        return std.Result.Error(Error(1, "Practice field lost Unicode input"));
      }
      renderer.click(try session.tree.identity(8));
      try renderer.poll(session.tree, session.queue, false);
      try session.dispatch(renderer);
      if (not session.state.text.is_empty()) {
        return std.Result.Error(Error(1, "Clear did not update the practice field"));
      }
      session.tree.shutdown(renderer);
      std.io.println("Accent practice window acceptance passed");
      return std.Result.Ok;
    }
    while (renderer.running()) {
      try renderer.poll(session.tree, session.queue, true);
      try session.dispatch(renderer);
    }
    session.tree.shutdown(renderer);
    return std.Result.Ok;
  }
}
