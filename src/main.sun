using std;

/** Starts the desktop input service or the separate sun_ui practice window. */
function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) i32 throws {
  var a = make_heap_allocator();
  var env = std.env.Env(a);
  var args = env.args(argc, argv);
  if (args.size() == 2 and
    (args[1].equals_literal("--ibus") or args[1].equals_literal("--register"))) {
    return accent_ibus.run(args[1].equals_literal("--register"));
  }
  if (args.size() > 2 or (args.size() == 2 and not args[1].equals_literal("--self-test"))) {
    std.io.eprintln("Usage: sun_accent_popup [--ibus|--register|--self-test]");
    return 1;
  }
  accent_app.run(args.size() == 2);
  return 0;
}
manifest {
  libraries: [
    "stdlib.moon",
    "${namo-robotics/sun_ui}/lib/sun_ui.moon",
    "${namo-robotics/sun_gobject}/lib/sun_gobject.moon",
    "${namo-robotics/sun_gobject}/lib/sun_gtk.moon",
    "${namo-robotics/sun_ui}/lib/sun_ui_gtk.moon"
  ]
  source_files: [
    "state.sun",
    "view.sun",
    "platform/ibus.sun"
  ]
}
