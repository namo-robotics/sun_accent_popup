using std;

/** Starts the desktop input service or the separate sun_ui practice window. */
function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) i32 {
  var a = make_heap_allocator();
  var env = std.env.Env(a);
  var args = env.args(argc, argv);
  if (args.size() == 2 and (args[1].equals_literal("--ibus") or args[1].equals_literal("--register"))) {
    return accent_ibus.run(args[1].equals_literal("--register"));
  }
  if (args.size() > 2 or (args.size() == 2 and not args[1].equals_literal("--self-test"))) {
    eprintln("Usage: sun_accent_popup [--ibus|--register|--self-test]");
    return 1;
  }
  return match accent_app.run(args.size() == 2) {
    SystemResult.Ok => 0,
    SystemResult.Error(error) => {
      eprintln(error.message());
      return 1;
    }
  };
}
manifest {
  libraries: ["stdlib.moon", "sun_ui.moon", "sun_gobject.moon", "sun_gtk.moon", "sun_ui_gtk.moon"]
  source_files: ["state.sun", "view.sun", "platform/ibus.sun"]
}
