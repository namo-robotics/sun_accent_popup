using std;

/** Packages the tested application for Debian and Snapcraft. */
module accent_package {

  /** Runs a packaging utility and reports its output on failure. */
  function capture(command: ref std.process.Command) SystemResult<String> {
    var output = try command.output();
    if (output.status() != 0) {
      std.io.eprint(output.stderr());
      return SystemResult.Error(
        try Error(output.status(), "Packaging command failed")
      );
    }
    return SystemResult.Ok(
      try output.stdout().clone(make_heap_allocator())
    );
  }

  /** Reads one Debian changelog field without duplicating package metadata. */
  function field(name: static_ptr<u8>) SystemResult<String> {
    var command = try std.process.Command(make_heap_allocator(), "dpkg-parsechangelog");

    try command.add_arg("-S");
    try command.add_arg(name);
    var result = try capture(command);
    result.trim();
    return SystemResult.Ok(result);
  }

  /** Copies a required file with explicit install permissions. */
  function install(source: String, destination: String, executable: bool) SystemResult<void> {
    var command = try std.process.Command(make_heap_allocator(), "install");

    try command.add_arg("-D");
    try command.add_arg("-m");
    try command.add_arg(executable ? "755" : "644");
    try command.add_arg(source);
    try command.add_arg(destination);
    var status = try command.status();
    if (status != 0) {
      return SystemResult.Error(Error(status, "Cannot stage application payload"));
    }
    return SystemResult.Ok;
  }

  /** Reads an explicit dependency source override for license notices. */
  function source(name: static_ptr<u8>, fallback: static_ptr<u8>) AllocationResult<String> {
    var a = make_heap_allocator();
    var env = try std.env.Env(a);
    return AllocationResult.Ok(
      match env.get(name) {
        Option.Some(value) => try value.clone(a),
        Option.None => try String(fallback)
      }
    );
  }

  /** Creates a clean payload without installing or changing the desktop input source. */
  public function stage(snap: bool) SystemResult<void> {
    var a = make_heap_allocator();
    var target = try build_targets.load("sun_accent_popup");
    var root = try String(snap ? "build/accent-package/root" : "build/accent-deb/root");

    var clear = try std.process.Command(a, "rm");
    try clear.add_arg("-rf");
    try clear.add_arg(root);
    var status = try clear.status();
    if (status != 0) {
      return SystemResult.Error(Error(status, "Cannot clear old package payload"));
    }
    try install(
      try target.output.clone(a),
      try `${root}/usr/bin/sun_accent_popup`,
      true
    );
    if (snap) {
      try install(
        try String("snap/local/engine"),
        try `${root}/bin/engine`,
        true
      );
      try install(
        try String("snap/local/sun-accent-popup.xml"),
        try `${root}/usr/share/ibus/component/sun-accent-popup.xml`,
        false
      );
      try install(
        try String("snap/local/sun-accent-popup.desktop"),
        try `${root}/usr/share/applications/sun-accent-popup.desktop`,
        false
      );
    } else {
      try install(
        try String("debian/sun-accent-popup.xml"),
        try `${root}/usr/share/ibus/component/sun-accent-popup.xml`,
        false
      );
      try install(
        try String("debian/sun-accent-popup.desktop"),
        try `${root}/usr/share/applications/sun-accent-popup.desktop`,
        false
      );
    }
    var notices = try `${root}/usr/share/doc/sun-accent-popup`;
    try install(
      try String("LICENSE"),
      try `${notices}/copyright`,
      false
    );
    try install(
      try String("build/sun-version.txt"),
      try `${notices}/sun-version.txt`,
      false
    );
    var ui = source("SUN_UI_SOURCE", "build/dependencies/sun_ui");
    var gtk = source("SUN_GOBJECT_SOURCE", "build/dependencies/sun_gobject");
    try install(
      try `${ui}/LICENSE`,
      try `${notices}/copyright.sun_ui`,
      false
    );
    try install(
      try `${gtk}/LICENSE`,
      try `${notices}/copyright.sun_gobject`,
      false
    );
    try install(
      try String("/usr/share/doc/sun/copyright"),
      try `${notices}/copyright.sun`,
      false
    );
    return SystemResult.Ok;
  }

  /** Generates exact linked-library dependencies and builds a root-owned Debian archive. */
  public function deb() SystemResult<void> {
    var a = make_heap_allocator();
    var architecture = try std.process.Command(a, "dpkg");
    try architecture.add_arg("--print-architecture");
    var arch = try capture(architecture);
    arch.trim();
    if (not arch.equals_literal("amd64")) {
      return SystemResult.Error(Error(1, "The initial release supports amd64 only"));
    }
    var version = try field("Version");
    var name = try field("Source");
    var package = try `build/${name}_${version}_${arch}.deb`;
    try stage(false);
    var target = try build_targets.load("sun_accent_popup");
    var dependencies = try std.process.Command(a, "dpkg-shlibdeps");

    try dependencies.add_arg("-O");
    try dependencies.add_arg("-e");
    try dependencies.add_arg(target.output);
    var variables = try capture(dependencies);
    try variables.append("misc:Depends=\n");
    var variables_path = try String("build/accent-deb/substvars");
    try std.io.write_string(variables_path, variables);
    var mkdir = try std.process.Command(a, "mkdir");
    try mkdir.add_arg("-p");
    try mkdir.add_arg("build/accent-deb/root/DEBIAN");
    var created = try capture(mkdir);
    var control = try std.process.Command(a, "dpkg-gencontrol");
    try control.add_arg("-psun-accent-popup");
    try control.add_arg("-Pbuild/accent-deb/root");
    try control.add_arg("-Tbuild/accent-deb/substvars");
    try control.add_arg("-fbuild/accent-deb/files");
    try control.add_arg("-Obuild/accent-deb/root/DEBIAN/control");
    var generated = try capture(control);
    var archive = try std.process.Command(a, "dpkg-deb");
    try archive.add_arg("--root-owner-group");
    try archive.add_arg("--build");
    try archive.add_arg("build/accent-deb/root");
    try archive.add_arg(package);
    var output = try capture(archive);
    std.io.print(output);
    return SystemResult.Ok;
  }

  /** Creates both distribution formats from the same tested executable. */
  public function package() SystemResult<void> {
    try stage(true);
    return deb();
  }
}

/** Reports payload staging failures to the build task. */
function main() AllocationResult<i32> {
  return AllocationResult.Ok(
    match accent_package.package() {
      SystemResult.Ok => 0,
      SystemResult.Error(error) => {
        std.io.eprintln(try error.message());
        return AllocationResult.Ok(1);
      }
    }
  );
}
manifest {
  libraries: [
    "stdlib.moon"
  ], source_files: [
    "targets.sun"
  ]
}
