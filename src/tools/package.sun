using std;

/** Packages the tested application for Debian and Snapcraft. */
module accent_package {

  /** Runs a packaging utility and reports its output on failure. */
  function capture(command: ref std.process.Command) String throws {
    var output = command.output();
    if (output.status() != 0) {
      std.io.eprint(output.stderr());
      throw Error(output.status(), "Packaging command failed");
    }
    return output.stdout().clone(make_heap_allocator());
  }

  /** Reads one Debian changelog field without duplicating package metadata. */
  function field(name: static_ptr<u8>) String throws {
    var command = std.process.Command(make_heap_allocator(), "dpkg-parsechangelog");

    command.add_arg("-S");
    command.add_arg(name);
    var result = capture(command);
    result.trim();
    return result;
  }

  /** Copies a required file with explicit install permissions. */
  function install(source: String, destination: String, executable: bool) void throws {
    var command = std.process.Command(make_heap_allocator(), "install");

    command.add_arg("-D");
    command.add_arg("-m");
    command.add_arg(executable ? "755" : "644");
    command.add_arg(source);
    command.add_arg(destination);
    var status = command.status();
    if (status != 0) {
      throw Error(status, "Cannot stage application payload");
    }
    return;
  }

  /** Reads an explicit dependency source override for license notices. */
  function source(name: static_ptr<u8>, fallback: static_ptr<u8>) String throws {
    var a = make_heap_allocator();
    var env = std.env.Env(a);
    return match env.get(name) {
      Option.Some(value) => value.clone(a),
      Option.None => String(fallback)
    };
  }

  /** Creates a clean payload without installing or changing the desktop input source. */
  public function stage(snap: bool) void throws {
    var a = make_heap_allocator();
    var target = build_targets.load("sun_accent_popup");
    var root = String(snap ? "build/accent-package/root" : "build/accent-deb/root");

    var clear = std.process.Command(a, "rm");
    clear.add_arg("-rf");
    clear.add_arg(root);
    var status = clear.status();
    if (status != 0) {
      throw Error(status, "Cannot clear old package payload");
    }
    install(
      target.output.clone(a),
      `${root}/usr/bin/sun_accent_popup`,
      true
    );
    if (snap) {
      install(
        String("snap/local/engine"),
        `${root}/bin/engine`,
        true
      );
      install(
        String("snap/local/sun-accent-popup.xml"),
        `${root}/usr/share/ibus/component/sun-accent-popup.xml`,
        false
      );
      install(
        String("snap/local/sun-accent-popup.desktop"),
        `${root}/usr/share/applications/sun-accent-popup.desktop`,
        false
      );
    } else {
      install(
        String("debian/sun-accent-popup.xml"),
        `${root}/usr/share/ibus/component/sun-accent-popup.xml`,
        false
      );
      install(
        String("debian/sun-accent-popup.desktop"),
        `${root}/usr/share/applications/sun-accent-popup.desktop`,
        false
      );
    }
    var notices = `${root}/usr/share/doc/sun-accent-popup`;
    install(
      String("LICENSE"),
      `${notices}/copyright`,
      false
    );
    install(
      String("build/sun-version.txt"),
      `${notices}/sun-version.txt`,
      false
    );
    var ui = source("SUN_UI_SOURCE", "build/dependencies/sun_ui");
    var gtk = source("SUN_GOBJECT_SOURCE", "build/dependencies/sun_gobject");
    install(
      `${ui}/LICENSE`,
      `${notices}/copyright.sun_ui`,
      false
    );
    install(
      `${gtk}/LICENSE`,
      `${notices}/copyright.sun_gobject`,
      false
    );
    install(
      String("/usr/share/doc/sun/copyright"),
      `${notices}/copyright.sun`,
      false
    );
    return;
  }

  /** Generates exact linked-library dependencies and builds a root-owned Debian archive. */
  public function deb() void throws {
    var a = make_heap_allocator();
    var architecture = std.process.Command(a, "dpkg");
    architecture.add_arg("--print-architecture");
    var arch = capture(architecture);
    arch.trim();
    if (not arch.equals_literal("amd64")) {
      throw Error(1, "The initial release supports amd64 only");
    }
    var version = field("Version");
    var name = field("Source");
    var package = `build/${name}_${version}_${arch}.deb`;
    stage(false);
    var target = build_targets.load("sun_accent_popup");
    var dependencies = std.process.Command(a, "dpkg-shlibdeps");

    dependencies.add_arg("-O");
    dependencies.add_arg("-e");
    dependencies.add_arg(target.output);
    var variables = capture(dependencies);
    variables.append("misc:Depends=\n");
    var variables_path = String("build/accent-deb/substvars");
    std.io.write_string(variables_path, variables);
    var mkdir = std.process.Command(a, "mkdir");
    mkdir.add_arg("-p");
    mkdir.add_arg("build/accent-deb/root/DEBIAN");
    var created = capture(mkdir);
    var control = std.process.Command(a, "dpkg-gencontrol");
    control.add_arg("-psun-accent-popup");
    control.add_arg("-Pbuild/accent-deb/root");
    control.add_arg("-Tbuild/accent-deb/substvars");
    control.add_arg("-fbuild/accent-deb/files");
    control.add_arg("-Obuild/accent-deb/root/DEBIAN/control");
    var generated = capture(control);
    var archive = std.process.Command(a, "dpkg-deb");
    archive.add_arg("--root-owner-group");
    archive.add_arg("--build");
    archive.add_arg("build/accent-deb/root");
    archive.add_arg(package);
    var output = capture(archive);
    std.io.print(output);
    return;
  }

  /** Creates both distribution formats from the same tested executable. */
  public function package() void throws {
    stage(true);
    return deb();
  }
}

/** Reports payload staging failures to the build task. */
function main() i32 throws {
  try {
    accent_package.package();
    return 0;
  } catch (error: std.Error) {
    std.io.eprintln(error.message());
    return 1;
  }
}
manifest {
  libraries: [
    "stdlib.moon"
  ], source_files: [
    "targets.sun"
  ]
}
