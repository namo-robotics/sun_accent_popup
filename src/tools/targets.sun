using std;

/** Reads executable paths from the compiler's resolved build configuration. */
module build_targets {

  /** Owns the application and companion test runner paths for one build product. */
  public class Target {
    public var output: String;
    public var tests: String;

    /** Takes ownership of the paths returned by the compiler. */
    init(output: String, tests: String) {
      this.output = output;
      this.tests = tests;
    }
  }

  /** Selects a named product from the compiler's entrypoint list. */
  function select(document: ref std.json.Json, name: static_ptr<u8>) Target throws {
    var a = make_heap_allocator();
    var entries = document.get("entrypoints");
    for (var i: i64 = 0; i < entries.len(); i += 1) {
      var entry = entries.at(i);
      var entry_name = (entry.get("name")).as_string();
      if (entry_name.equals_literal(name)) {
        var output = (entry.get("output_name")).as_string();
        var tests = (entry.get("test_binary_name")).as_string();
        return Target(output.clone(a), tests.clone(a));
      }
    }
    throw std.json.JsonError("Unknown build target", -1);
  }

  /** Returns the configured compiler executable or the default found on PATH. */
  public function compiler() String throws {
    var a = make_heap_allocator();
    var env = std.env.Env(a);
    return match env.get("SUN_EXECUTABLE") {
      Option.Some(value) => value.clone(a),
      Option.None => String("sun")
    };
  }

  /** Loads a product without duplicating the compiler's output-path rules. */
  public function load(name: static_ptr<u8>) Target throws {
    var a = make_heap_allocator();
    var command = std.process.Command(a, compiler());
    command.add_arg("describe");
    command.add_arg("--config");
    command.add_arg("sun-config.json");
    var output = command.output();
    if (output.status() != 0) {
      std.io.eprint(output.stderr());
      throw Error(output.status(), "Cannot resolve build configuration");
    }
    var text = output.stdout().clone(a);
    try {
      var document = std.json.parse_json(a, text);
      return select(document, name);
    } catch (error: std.json.JsonError) {
      std.io.eprintln(name);
      std.io.eprintln(error.message());
      throw Error(1, "Cannot load configured build target");
    }
  }
}
